<?xml version="1.0" encoding="utf-8"?>
<!-- R8/Ressourcen-Schrumpfen (isShrinkResources): Ressourcen, die nur per
     Name geladen werden, duerfen nicht entfernt werden.
     - ic_stat_linefm: Benachrichtigungs-Icon, audio_service laedt es ueber
       "drawable/ic_stat_linefm" (androidNotificationIcon).
     - auto_station_*: Senderlogos fuer Android Auto, die App liefert sie als
       android.resource://de.linefm.app/drawable/auto_station_<slug>.
     Geprueft mit aapt2 dump resources am Release-APK (P16). -->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/ic_stat_linefm,@drawable/auto_station_*" />
