<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Startfenster bis Android 11: Hintergrund #0F1221 mit App-Icon,
         unabhaengig vom Hell-/Dunkelmodus (Spec 4.1). Flutter entfernt es mit
         dem ersten Frame; danach uebernimmt der Ladebildschirm der App. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Fenster hinter der Flutter-Oberflaeche. Dunkel wie Ladebildschirm und
         Splash, damit beim Start kein heller Blitz entsteht. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/linefm_background</item>
    </style>
</resources>
