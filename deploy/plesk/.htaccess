# Plesk mit Apache (nginx-Proxy aus oder "Intelligente Verarbeitung statischer Dateien" aus).
# Ablage: Dokumentstamm der Domain (httpdocs/.htaccess). Anleitung: docs/hosting-plesk.md
# Setzt mod_headers, mod_rewrite, mod_mime, mod_expires-unabhaengig (Cache per Header) voraus.
# __CSP_CONNECT_EXTRA__ ersetzt tool/web_postbuild.dart.
# Nicht zusammen mit den nginx-Direktiven aus nginx-additional.conf verwenden (doppelte Header).

Options -Indexes
DirectoryIndex index.html
AddDefaultCharset UTF-8
FileETag MTime Size

<IfModule mod_mime.c>
    AddType application/wasm .wasm
    AddType font/otf .otf
    AddType font/ttf .ttf
    AddType text/javascript .js .mjs
    AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_headers.c>
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://cdn.linefm.de https://*.mzstatic.com https://assets.laut.fm https://radiogruppe.de; connect-src 'self' https://api.laut.fm wss://api.laut.fm https://itunes.apple.com https://*.mzstatic.com https://cdn.linefm.de https://assets.laut.fm https://radiogruppe.de __CSP_CONNECT_EXTRA__; media-src https://*.laut.fm blob:; font-src 'self'; worker-src 'self' blob:; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'; object-src 'none'; upgrade-insecure-requests"
    Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Cross-Origin-Resource-Policy "same-origin"
    Header always set X-Frame-Options "DENY"

    # Cache-Strategie (Spec 6.2). Standard: immer revalidieren.
    Header always set Cache-Control "no-cache"
    <FilesMatch "^main\.[0-9a-f]{8}\.dart\.(js|mjs|wasm)$">
        Header always set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <If "%{REQUEST_URI} =~ m#^/canvaskit/#">
        Header always set Cache-Control "public, max-age=31536000, immutable"
    </If>
    <If "%{REQUEST_URI} =~ m#^/(assets|icons)/# || %{REQUEST_URI} =~ m#^/favicon\.png$#">
        Header always set Cache-Control "public, max-age=86400, stale-while-revalidate=604800"
    </If>
    # Feste Namen, Inhalt aendert sich pro Build: immer revalidieren (steht nach dem assets-Block, gewinnt dort).
    <If "%{REQUEST_URI} =~ m#^/assets/(AssetManifest[^/]*|FontManifest\.json|NOTICES)$#">
        Header always set Cache-Control "no-cache"
    </If>
    <FilesMatch "^(robots\.txt|sitemap\.xml|llms\.txt)$">
        Header always set Cache-Control "public, max-age=3600"
    </FilesMatch>
</IfModule>

# Brotli: mod_brotli (Apache 2.4.26+), falls auf dem Server vorhanden, vor mod_deflate aktivieren
# (siehe docs/hosting-plesk.md). NOTICES und AssetManifest.bin sind octet-stream.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/json application/javascript text/javascript application/manifest+json application/wasm image/svg+xml application/octet-stream font/otf font/ttf application/vnd.ms-fontobject
</IfModule>

<FilesMatch "^(_headers|_redirects)$">
    Require all denied
</FilesMatch>

# SPA-Routing (Pfad-Strategie): Dateien und Ordner direkt, fehlende Dateien mit Endung als 404,
# alles andere liefert index.html.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
    RewriteRule \.[a-zA-Z0-9]{2,6}$ - [R=404,L]
    # Rechtstexte sind eigene statische Seiten, kein SPA-Fallback.
    RewriteRule ^(impressum|datenschutz)(/|$) - [R=404,L]
    RewriteRule ^ index.html [L]
</IfModule>
