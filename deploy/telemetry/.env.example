# Kopieren nach .env (wird NICHT eingecheckt) und alle Werte ersetzen.
# Zufallswerte erzeugen: openssl rand -hex 32

UMAMI_DB_PASSWORD=
UMAMI_APP_SECRET=
# Umami legt beim ersten Start admin / umami an. Passwort direkt nach dem ersten Login aendern,
# bevor Umami aus dem Netz erreichbar ist (docs/telemetry.md).
GLITCHTIP_DB_PASSWORD=
GLITCHTIP_SECRET_KEY=

# Lokal reichen die Defaults. Fuer Betrieb hinter Traefik/nginx die echte URL
# inkl. Schema setzen (z. B. https://fehler.example.org).
GLITCHTIP_DOMAIN=http://localhost:8000
GLITCHTIP_FROM_EMAIL=glitchtip@example.org
# SMTP, z. B. smtp://user:pass@mail.example.org:587 (leer = consolemail://)
GLITCHTIP_EMAIL_URL=consolemail://
# Registrierung ist standardmaessig aus. Erstes Konto per Kommandozeile anlegen
# (docs/telemetry.md). Nur zum Einrichten kurz auf true stellen, danach wieder false.
GLITCHTIP_ENABLE_USER_REGISTRATION=false
GLITCHTIP_ENABLE_ORGANIZATION_CREATION=false

# Nur lokale Ports (127.0.0.1)
UMAMI_PORT=3000
GLITCHTIP_PORT=8000

# Nur fuer compose.traefik.yml
UMAMI_HOST=statistik.example.org
GLITCHTIP_HOST=fehler.example.org
TRAEFIK_NETWORK=traefik
TRAEFIK_CERT_RESOLVER=letsencrypt
TRAEFIK_ENTRYPOINT=websecure
# Admin-Oberflaechen (Umami, GlitchTip) nur aus diesen Netzen, kommagetrennte CIDR-Liste.
TELEMETRY_ADMIN_SOURCES=203.0.113.10/32
