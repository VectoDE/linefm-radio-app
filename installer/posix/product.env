# Product data for the macOS and Linux installers (installer/posix/engine.sh).
# KEY=VALUE, parsed as text and never sourced. The build scripts copy this
# file next to the engine and append VERSION and SIZE. Windows keeps its own
# file (packaging/windows/installer.ini) with the same values.
NAME=LINEFM Radio
PUBLISHER=LineFM Studios
MANUFACTURER=Tim Hauke
URL=https://app.linefm.de
APP_ID=de.linefm.app
SCHEME=linefm
EXE=linefm_radio
