// Ressourcen von setup.exe / uninstall.exe. Wird von CMake erzeugt
// (configure_file), Platzhalter @...@ setzt CMakeLists.txt.
#include <winres.h>

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

// Erstes Symbol = Symbol der EXE im Explorer.
1 ICON "@LF_ICON_RC@"

// Manifest: asInvoker (verhindert die automatische UAC-Abfrage, die Windows
// fuer Dateien namens "setup.exe" sonst ausloest), DPI pro Monitor,
// lange Pfade, moderne Steuerelemente.
1 RT_MANIFEST "@LF_MANIFEST_RC@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @LF_VERSION_MAJOR@,@LF_VERSION_MINOR@,@LF_VERSION_PATCH@,0
 PRODUCTVERSION @LF_VERSION_MAJOR@,@LF_VERSION_MINOR@,@LF_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "LineFM Studios"
            VALUE "FileDescription", "LINEFM Radio Setup"
            VALUE "FileVersion", "@LF_VERSION@"
            VALUE "InternalName", "setup"
            VALUE "LegalCopyright", "Copyright (C) 2026 LineFM Studios"
            VALUE "OriginalFilename", "setup.exe"
            VALUE "ProductName", "LINEFM Radio"
            VALUE "ProductVersion", "@LF_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
